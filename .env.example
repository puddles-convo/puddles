# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Every variable the code reads is listed. Required depends on what you run.

# --- Helper and simulated user (training conversations, baselines, the loop) ---
# Any OpenAI-compatible server; see loop/llm.py client_from_env.
HELPER_URL=
HELPER_MODEL=
# HELPER_API_KEY=            # optional
# HELPER_EXTRA_BODY=         # optional JSON merged into every request body
SIMUSER_URL=
SIMUSER_MODEL=
# SIMUSER_API_KEY=
# SIMUSER_EXTRA_BODY=

# --- Judge (scripts/score_baselines.py, the gate, calibration) ---
# PUDDLES_JUDGE selects the judge: "panel" (default) or "fallback".
PUDDLES_JUDGE=panel
# Panel: three distinct OpenAI models, comma-separated, plus Astra the final judge.
PUDDLES_JUDGE_PANEL=
PUDDLES_JUDGE_ASTRA=
# PUDDLES_JUDGE_TEMPERATURE=0
# Fallback judge on Tinker (PUDDLES_JUDGE=fallback):
# PUDDLES_FALLBACK_JUDGE_MODEL=
# TINKER_API_KEY=
# PUDDLES_TINKER_BASE_URL=

# --- Agents: critic, researcher, proposer (puddles.llm.OpenAILLM) ---
OPENAI_API_KEY=
PUDDLES_AGENT_MODEL=
# PUDDLES_AGENT_TEMPERATURE=

# --- Safety check (the gate's judged assertions; defaults to the astra model) ---
# PUDDLES_SAFETY_MODEL=

# --- Researcher ---
EXA_API_KEY=

# --- past.dev memory ---
PAST_API_KEY=
# PAST_BASE_URL=

# --- Tracing and config ---
# MLFLOW_TRACKING_URI=sqlite:///runs/mlflow.db
# PUDDLES_CONFIG=config/run.toml
# PUDDLES_CACHE=~/.cache/puddles     # where the ESConv download is cached

# --- Eval-only helpers (outside sets, VERA; not needed for the loop) ---
# PUDDLES_HELPER_MODEL=            # eval/ stand-in helper for the outside checks
# PUDDLES_HELPER_BASE_URL=
# PUDDLES_HELPER_API_KEY=
# PUDDLES_HELPER_TEMPERATURE=0
# PUDDLES_VERA_ROOT=
# PUDDLES_VERA_POLICY=

# Our Qwen3.5-9B helper on Modal (deploy/modal_helper.py; scripts/qwen_check.sh).
# MODAL_HELPER_API_KEY is the value stored in the Modal Secret puddles-helper-key.
# MODAL_HELPER_API_KEY=
# MODAL_HELPER_URL=https://<workspace>--puddles-helper-serve.us-east.modal.run/v1
